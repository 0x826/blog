---
import { site } from "../consts";
import { getPublishedPosts } from "../lib/posts";
import PageLayout from "../layouts/PageLayout.astro";

const posts = await getPublishedPosts();
---

<PageLayout title="关于" description={`关于 ${site.name} 与作者 ${site.author}`}>
  <article class="about">
    <h1>关于</h1>
    <p>
      你好，我是 {site.author},
    </p>
    <p>
      {site.email},
    </p>
    <p>目前已发布 {posts.length} 篇文章。</p>
    
  </article>
</PageLayout>

<style>
  h1 {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0 0 1rem;
  }
</style>
