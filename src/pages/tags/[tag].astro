---
import {
  getAllTags,
  getPublishedPosts,
  slugifyTag,
} from "../../lib/posts";
import { withBase } from "../../lib/paths";
import PageLayout from "../../layouts/PageLayout.astro";
import PostGrid from "../../components/PostGrid.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  return tags.map((tag) => ({
    params: { tag: slugifyTag(tag.name) },
    props: { tagName: tag.name },
  }));
}

const { tagName } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) =>
  post.data.tags.includes(tagName),
);
---

<PageLayout title={tagName} description={`${tagName} 相关文章`}>
  <header class="topic-header">
    <h1>{tagName}</h1>
    <p>
      {posts.length} 篇文章 · <a href={withBase("/tags/")}>全部标签</a>
    </p>
  </header>
  <PostGrid posts={posts} />
</PageLayout>

<style>
  .topic-header {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0 0 0.55rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
    color: var(--ink-muted);
  }

  a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
