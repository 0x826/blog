---
import { getAllTags, getPublishedPosts, slugifyTag } from "../../lib/posts";
import { withBase } from "../../lib/paths";
import PageLayout from "../../layouts/PageLayout.astro";

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<PageLayout title="标签" description="按标签浏览文章">
  <h1>标签</h1>
  <ul class="tags">
    {
      tags.map((tag) => (
        <li>
          <a href={withBase(`/tags/${slugifyTag(tag.name)}/`)}>
            {tag.name}
            <span>({tag.count})</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  h1 {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 1.8rem;
    font-weight: 900;
  }

  .tags {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.5rem;
  }

  span {
    color: var(--ink-faint);
  }
</style>
