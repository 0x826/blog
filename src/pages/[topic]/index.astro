---
import { topics } from "../../consts";
import {
  getPostsByTopic,
  getPublishedPosts,
  isTopicId,
} from "../../lib/posts";
import PageLayout from "../../layouts/PageLayout.astro";
import PostGrid from "../../components/PostGrid.astro";

export async function getStaticPaths() {
  return topics.map((topic) => ({
    params: { topic: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = isTopicId(topic.id) ? getPostsByTopic(allPosts, topic.id) : [];
---

<PageLayout title={topic.label} description={topic.description}>
  <header class="topic-header">
    <h1>{topic.label}</h1>
    <p>{topic.description}</p>
  </header>
  {
    posts.length === 0 ? (
      <p class="empty">该主题下暂无文章。</p>
    ) : (
      <PostGrid posts={posts} />
    )
  }
</PageLayout>

<style>
  .topic-header {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0 0 0.55rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
  }

  .empty {
    padding: 2rem 0;
    color: var(--ink-muted);
    border-top: 1px solid var(--line);
  }
</style>
