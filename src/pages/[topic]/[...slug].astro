---
import { render } from "astro:content";
import {
  getAdjacentPosts,
  getPostSlug,
  getPostTopicId,
  getPublishedPosts,
  getRelatedPosts,
  isTopicId,
  readingTimeFromBody,
} from "../../lib/posts";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts
    .filter((post) => isTopicId(getPostTopicId(post.id)))
    .map((post) => ({
      params: {
        topic: getPostTopicId(post.id),
        slug: getPostSlug(post.id),
      },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getPublishedPosts();
const topicPosts = allPosts.filter(
  (p) => getPostTopicId(p.id) === getPostTopicId(post.id),
);
const related = getRelatedPosts(post, allPosts, 3);
const { prev, next } = getAdjacentPosts(post, topicPosts);
const readingMinutes = readingTimeFromBody(post.body);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  series={post.data.series}
  heroImage={post.data.heroImage}
  postId={post.id}
  readingMinutes={readingMinutes}
  related={related}
  prev={prev}
  next={next}
>
  <Content />
</BlogPost>
