---
import "../styles/global.css";
import { site } from "../consts";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — A blog by ${site.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase("/rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" id="site-favicon" type="image/x-icon" href={withBase("/favicon.ico")} />
    <script define:vars={{ delayedFaviconUrl: "https://assets.alicdn.com/g/qwenweb/qwen-chat-fe/0.2.81/static/images/ms-icon-light-150x150.png" }}>
      const link = document.getElementById("site-favicon");
      if (link) {
        // 3s 后切换 favicon，避免首屏缓存/加载抖动。
        window.setTimeout(() => {
          const url = delayedFaviconUrl;
          // 兼容 tp / MetaMask 内置 WebView：
          // 不使用 objectURL（部分内置 WebView 对此不生效），改为 Image 预加载后直接替换 href。
          const finalize = () => {
            link.rel = "icon";
            link.type = "image/png";
            link.sizes = "150x150";
            link.href = url;
          };

          const img = new Image();
          let done = false;
          const guardTimer = window.setTimeout(() => {
            if (done) return;
            done = true;
            finalize();
          }, 5000);

          img.onload = () => {
            if (done) return;
            done = true;
            window.clearTimeout(guardTimer);
            finalize();
          };
          img.onerror = () => {
            if (done) return;
            done = true;
            window.clearTimeout(guardTimer);
            finalize();
          };

          img.src = url;
        }, 3000);
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
