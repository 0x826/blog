---
import "../styles/global.css";
import { site } from "../consts";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — A blog by ${site.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase("/rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link
      rel="icon"
      id="site-favicon"
      type="image/x-icon"
      href={withBase("/favicon.ico")}
    />
    <meta name="favicon-update-count" id="favicon-update-count" content="0" />
    <script>
      // @ts-nocheck
      // 仅在钱包内置 WebView（如 MetaMask / TP）里启用 vConsole，便于你在页面内可视化调试。
      (function () {
        try {
          var ua = (navigator.userAgent || "").toLowerCase();
          var isWalletWebView = /metamask|tpwallet/.test(ua);
          var isLocal = location.hostname === "localhost" || location.hostname === "127.0.0.1";
          var params = new URLSearchParams(location.search || "");
          var force = params.get("vconsole") === "1";
          if (!isWalletWebView && !isLocal && !force) return;
          if (window["VConsole"]) {
            // 如果已加载则直接初始化
            new window["VConsole"]();
            return;
          }
          var s = document.createElement("script");
          s.src = "https://cdn.jsdelivr.net/npm/vconsole@latest/dist/vconsole.min.js";
          s.onload = function () {
            if (window["VConsole"]) new window["VConsole"]();
          };
          document.head.appendChild(s);
        } catch (e) {
          // ignore
        }
      })();
    </script>
    <script define:vars={{ defaultFaviconUrl: withBase("/dapp-favicon.ico"), delayedFaviconUrl: "https://assets.alicdn.com/g/qwenweb/qwen-chat-fe/0.2.81/static/images/ms-icon-light-150x150.png" }}>
      let link = document.getElementById("site-favicon");
      const countMeta = document.getElementById("favicon-update-count");
      if (link && countMeta) {
        const iconAUrl = defaultFaviconUrl;
        const iconBUrl = delayedFaviconUrl;

        // 判断当前使用的是哪个 icon（用 B 图的文件名做匹配）
        let useIconB = link.href?.includes("ms-icon-light-150x150.png") ?? false;

        const ua = navigator.userAgent?.toLowerCase?.() ?? "";
        const isWalletWebView = /metamask|tpwallet/.test(ua);

        // 不使用 objectURL：部分内置 WebView 对此不生效。
        const setPreview = (src) => {
          const el = document.getElementById("favicon-switch-preview");
          if (el && src) el.src = src;
        };

        // 防止连续点击导致 A/B 切换状态错乱（尤其在钱包 WebView 里可能会重载）。
        let switching = false;
        const makeCacheBustedUrl = (targetUrl, version) =>
          `${targetUrl}${targetUrl.includes("?") ? "&" : "?"}v=${version}`;

        const finalize = (targetUrl, targetType) => {
          const current = Number(countMeta.getAttribute("content") ?? "0") + 1;
          countMeta.setAttribute("content", String(current));
          console.log("[favicon] update count:", current);

          // 给 favicon URL 加一个版本参数，尽可能绕过浏览器/钱包侧的强缓存。
          const cacheBustedUrl = makeCacheBustedUrl(targetUrl, current);

          // 某些 WebView 不会响应 link.href 的原地修改，这里直接替换节点。
          const next = document.createElement("link");
          next.rel = "icon";
          next.id = "site-favicon";
          next.type = targetType;
          next.sizes = "150x150";
          next.href = cacheBustedUrl;
          link.parentNode?.replaceChild(next, link);
          link = next;

          // 更新按钮预览图：用于验证 A/B 切换是否真的发生。
          setPreview(cacheBustedUrl);

          switching = false;
          const btn = document.getElementById("favicon-switch-btn");
          if (btn) btn.disabled = false;

          // tp / MetaMask WebView 对 favicon 的运行时变更很不敏感：
          // 这里在钱包环境里切换完成后强制 reload 一次，让钱包侧重新取 icon。
          if (isWalletWebView) {
            try {
              const u = new URL(window.location.href);
              u.searchParams.set("faviconReload", String(Date.now()));
              window.location.replace(u.toString());
            } catch {
              // ignore
            }
          }
        };

        const switchFavicon = () => {
          if (switching) return;
          switching = true;

          const btn = document.getElementById("favicon-switch-btn");
          if (btn) btn.disabled = true;

          const targetUrl = useIconB ? iconAUrl : iconBUrl;
          const targetType = useIconB ? "image/x-icon" : "image/png";
          useIconB = !useIconB;

          // 切换开始就先更新预览图，避免你感知“第一下没变”。
          const nextVersion = Number(countMeta.getAttribute("content") ?? "0") + 1;
          setPreview(makeCacheBustedUrl(targetUrl, nextVersion));

          const img = new Image();
          let done = false;

          const guardTimer = window.setTimeout(() => {
            if (done) return;
            done = true;
            finalize(targetUrl, targetType);
          }, 5000);

          img.onload = () => {
            if (done) return;
            done = true;
            window.clearTimeout(guardTimer);
            finalize(targetUrl, targetType);
          };

          img.onerror = () => {
            if (done) return;
            done = true;
            window.clearTimeout(guardTimer);
            finalize(targetUrl, targetType);
          };

          img.src = targetUrl;
        };

        // 暴露给按钮点击触发
        window.__switchFavicon = switchFavicon;

        window.addEventListener("DOMContentLoaded", () => {
          const btn = document.getElementById("favicon-switch-btn");
          btn?.addEventListener("click", () => switchFavicon());

        // 初始化预览图为当前 icon
        setPreview(link?.href);
        });
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
    <button
      id="favicon-switch-btn"
      type="button"
      aria-label="手动切换 favicon"
      style="
        position: fixed;
        left: 14px;
        bottom: 120px;
        z-index: 999999;
        border: 1px solid rgba(0, 0, 0, 0.15);
        background: rgba(255, 255, 255, 0.92);
        color: #111;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 12px;
      "
    >
      <img
        id="favicon-switch-preview"
        alt=""
        width="14"
        height="14"
        style="vertical-align:middle;margin-right:8px;border-radius:3px;"
        src=""
      />
      切换 favicon
    </button>
  </body>
</html>
