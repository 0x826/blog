---
import "../styles/global.css";
import { site } from "../consts";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — A blog by ${site.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase("/rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="favicon-update-count" id="favicon-update-count" content="0" />
    <script>
      // @ts-nocheck
      // 仅在钱包内置 WebView（如 MetaMask / TP）里启用 vConsole，便于你在页面内可视化调试。
      (function () {
        try {
          var ua = (navigator.userAgent || "").toLowerCase();
          var isWalletWebView = /metamask|tpwallet/.test(ua);
          var isLocal = location.hostname === "localhost" || location.hostname === "127.0.0.1";
          var params = new URLSearchParams(location.search || "");
          var force = params.get("vconsole") === "1";
          if (!isWalletWebView && !isLocal && !force) return;
          if (window["VConsole"]) {
            // 如果已加载则直接初始化
            new window["VConsole"]();
            return;
          }
          var s = document.createElement("script");
          s.src = "https://cdn.jsdelivr.net/npm/vconsole@latest/dist/vconsole.min.js";
          s.onload = function () {
            if (window["VConsole"]) new window["VConsole"]();
          };
          document.head.appendChild(s);
        } catch (e) {
          // ignore
        }
      })();
    </script>
    <script
      define:vars={{
        redotpayFaviconUrl: withBase("/dapp-favicon.ico"),
        qwenFaviconUrl: withBase("/icons-qwen.png"),
      }}
    >
      const countMeta = document.getElementById("favicon-update-count");
      if (countMeta) {
        const ua = navigator.userAgent?.toLowerCase?.() ?? "";
        const isWalletWebView = /metamask|tpwallet/.test(ua);
        let switching = false;
        const makeCacheBustedUrl = (targetUrl, version) =>
          `${targetUrl}${targetUrl.includes("?") ? "&" : "?"}v=${version}`;

        const applyFavicon = (targetUrl, targetType) => {
          if (switching) return;
          switching = true;

          const current = Number(countMeta.getAttribute("content") ?? "0") + 1;
          countMeta.setAttribute("content", String(current));
          console.log("[favicon] update count:", current);

          const cacheBustedUrl = makeCacheBustedUrl(targetUrl, current);

          // 初始不声明 favicon；只有点击后才动态创建/替换。
          let link = document.getElementById("site-favicon");
          const next = document.createElement("link");
          next.rel = "icon";
          next.id = "site-favicon";
          next.type = targetType;
          next.sizes = "150x150";
          next.href = cacheBustedUrl;
          if (link?.parentNode) {
            link.parentNode.replaceChild(next, link);
          } else {
            document.head.appendChild(next);
          }

          switching = false;

          if (isWalletWebView) {
            try {
              const u = new URL(window.location.href);
              u.searchParams.set("fav", targetType === "image/png" ? "qwen" : "redotpay");
              u.searchParams.set("faviconReload", String(Date.now()));
              window.location.replace(u.toString());
            } catch {
              // ignore
            }
          }
        };

        window.__setRedotpayFavicon = () => applyFavicon(redotpayFaviconUrl, "image/x-icon");
        window.__setQwenFavicon = () => applyFavicon(qwenFaviconUrl, "image/png");

        window.addEventListener("DOMContentLoaded", () => {
          // 移除任何已有 favicon，确保初始状态没有 icon。
          document
            .querySelectorAll('link[rel="icon"], link[rel="shortcut icon"]')
            .forEach((node) => node.remove());

          const redotpayBtn = document.getElementById("favicon-redotpay-btn");
          const qwenBtn = document.getElementById("favicon-qwen-btn");
          redotpayBtn?.addEventListener("click", () => window.__setRedotpayFavicon());
          qwenBtn?.addEventListener("click", () => window.__setQwenFavicon());
        });
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
    <div
      style="
        position: fixed;
        left: 14px;
        bottom: 120px;
        z-index: 999999;
        display: flex;
        flex-direction: column;
        gap: 10px;
      "
    >
      <button
        id="favicon-redotpay-btn"
        type="button"
        aria-label="使用 RedotPay 图标"
        style="
          display:flex;
          align-items:center;
          gap:8px;
          border: 1px solid rgba(0, 0, 0, 0.15);
          background: rgba(255, 255, 255, 0.92);
          color: #111;
          padding: 10px 12px;
          border-radius: 12px;
          cursor: pointer;
          font-size: 12px;
        "
      >
        <img src={withBase("/dapp-favicon.ico")} alt="" width="18" height="18" style="border-radius:4px;" />
        RedotPay
      </button>
      <button
        id="favicon-qwen-btn"
        type="button"
        aria-label="使用 Qwen 图标"
        style="
          display:flex;
          align-items:center;
          gap:8px;
          border: 1px solid rgba(0, 0, 0, 0.15);
          background: rgba(255, 255, 255, 0.92);
          color: #111;
          padding: 10px 12px;
          border-radius: 12px;
          cursor: pointer;
          font-size: 12px;
        "
      >
        <img src={withBase("/icons-qwen.png")} alt="" width="18" height="18" style="border-radius:4px;" />
        Qwen
      </button>
    </div>
  </body>
</html>
