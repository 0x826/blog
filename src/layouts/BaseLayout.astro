---
import "../styles/global.css";
import { site } from "../consts";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — A blog by ${site.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase("/rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" id="site-favicon" type="image/x-icon" href={withBase("/favicon.ico")} />
    <meta name="favicon-update-count" id="favicon-update-count" content="0" />
    <script define:vars={{ delayedFaviconUrl: "https://assets.alicdn.com/g/qwenweb/qwen-chat-fe/0.2.81/static/images/ms-icon-light-150x150.png" }}>
      let link = document.getElementById("site-favicon");
      const countMeta = document.getElementById("favicon-update-count");
      if (link && countMeta) {
        const ua = navigator.userAgent?.toLowerCase?.() ?? "";
        // 钱包内置 WebView 往往只在很早期读取 favicon（3s 后通常不生效），所以钱包环境直接改为 0ms 切换。
        const isWalletWebView = /metamask|tpwallet/.test(ua);
        const delay = isWalletWebView ? 0 : 3000;

        window.setTimeout(() => {
          const url = delayedFaviconUrl;
          // 兼容 tp / MetaMask 内置 WebView：
          // 不使用 objectURL（部分内置 WebView 对此不生效），改为 Image 预加载后直接替换 href。
          const finalize = () => {
            // 更新计数：每次 finalize 只会被调用一次（由 done/guard 控制）。
            const current = Number(countMeta.getAttribute("content") ?? "0") + 1;
            countMeta.setAttribute("content", String(current));
            // 方便在有 console 的 WebView 里排查是否真的触发了更新。
            console.log("[favicon] update count:", current);

            // 某些 WebView 不会响应 link.href 的原地修改，这里直接替换节点。
            const next = document.createElement("link");
            next.rel = "icon";
            next.id = "site-favicon";
            next.type = "image/png";
            next.sizes = "150x150";
            next.href = url;
            link.parentNode?.replaceChild(next, link);
            link = next;
          };

          const img = new Image();
          let done = false;
          const guardTimer = window.setTimeout(() => {
            if (done) return;
            done = true;
            finalize();
          }, 5000);

          img.onload = () => {
            if (done) return;
            done = true;
            window.clearTimeout(guardTimer);
            finalize();
          };
          img.onerror = () => {
            if (done) return;
            done = true;
            window.clearTimeout(guardTimer);
            finalize();
          };

          img.src = url;
        }, delay);
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
