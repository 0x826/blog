---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MacWindowEnhance from "../components/MacWindowEnhance.astro";
import { getTopic } from "../consts";
import type { Post } from "../lib/posts";
import {
  formatDate,
  getPostTopicId,
  readingLabel,
  slugifyTag,
} from "../lib/posts";
import { postHref, topicHref, withBase } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  series?: string;
  heroImage?: string;
  postId: string;
  readingMinutes: number;
  related: Post[];
  prev?: Post;
  next?: Post;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  series,
  heroImage,
  postId,
  readingMinutes,
  related,
  prev,
  next,
} = Astro.props;

const topic = getTopic(getPostTopicId(postId));
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="post-page">
    <article>
      <header class="header wrap-narrow">
        {
          topic && (
            <a class="topic" href={topicHref(topic.id)}>
              {topic.label}
            </a>
          )
        }
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate, "long")}</time>
          <span aria-hidden="true">·</span>
          <span>{readingLabel(readingMinutes)}</span>
          {series && (
            <>
              <span aria-hidden="true">·</span>
              <span>{series}</span>
            </>
          )}
        </p>
        {
          tags.length > 0 && (
            <p class="tags">
              {tags.map((tag, i) => (
                <>
                  {i > 0 && <span> · </span>}
                  <a href={withBase(`/tags/${slugifyTag(tag)}/`)}>{tag}</a>
                </>
              ))}
            </p>
          )
        }
        {
          updatedDate && (
            <p class="updated">更新于 {formatDate(updatedDate, "long")}</p>
          )
        }
      </header>

      {
        heroImage && (
          <div class="hero-image wrap">
            <img src={withBase(heroImage)} alt="" />
          </div>
        )
      }

      <div class="prose wrap-narrow">
        <slot />
      </div>
      <MacWindowEnhance />
    </article>

    {
      (prev || next) && (
        <nav class="pager wrap-narrow" aria-label="上下篇">
          {prev && (
            <p>
              上一篇：
              <a href={postHref(prev.id)}>{prev.data.title}</a>
            </p>
          )}
          {next && (
            <p>
              下一篇：
              <a href={postHref(next.id)}>{next.data.title}</a>
            </p>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <div class="wrap">
            <h2>继续阅读</h2>
            <ol class="related-grid">
              {related.map((post) => {
                const relatedTopic = getTopic(getPostTopicId(post.id));
                return (
                  <li>
                    {relatedTopic && (
                      <a class="related-topic" href={topicHref(relatedTopic.id)}>
                        {relatedTopic.label}
                      </a>
                    )}
                    <a class="related-title" href={postHref(post.id)}>
                      {post.data.title}
                    </a>
                    <p>{post.data.description}</p>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<style>
  .post-page {
    flex: 1;
    padding: 2.5rem 0 0;
  }

  .header {
    margin-bottom: 2rem;
  }

  .topic {
    display: inline-block;
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .topic:hover {
    color: var(--ink);
  }

  h1 {
    margin: 0 0 0.9rem;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .meta,
  .tags,
  .updated {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .meta span,
  .tags span {
    margin: 0 0.25rem;
  }

  .tags,
  .updated {
    margin-top: 0.4rem;
  }

  .tags a:hover {
    color: var(--ink);
  }

  .hero-image {
    margin: 0 auto 2.5rem;
  }

  .hero-image img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 1.5rem;
  }

  .prose :global(h2) {
    font-size: 1.45rem;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
  }

  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 3px;
    background: var(--code-bg);
  }

  .prose :global(pre) {
    padding: 1rem 1.1rem;
    overflow-x: auto;
    border-radius: 6px;
    background: #1e1e1e;
  }

  .prose :global(.mac-window) {
    margin: 1.5rem 0;
  }

  .prose :global(.mac-window pre) {
    margin: 0;
    border-radius: 0;
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--line);
    color: var(--ink-soft);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.5rem 0.4rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .pager {
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.98rem;
  }

  .pager p {
    margin: 0.45rem 0;
  }

  .pager a:hover {
    text-decoration: underline;
  }

  .related {
    margin-top: 3.5rem;
    padding: 2.75rem 0 3rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    margin: 0 0 1.5rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-topic {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .related-title {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .related-title:hover {
    opacity: 0.7;
  }

  .related p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 800px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
