---
import { site } from "../consts";
import { withBase } from "../lib/paths";
---

<section class="hero">
  <div class="hero-stage" aria-hidden="true">
    <div class="glow glow-a"></div>
    <div class="glow glow-b"></div>
    <div class="device">
      <div class="screen">
        <div class="screen-line"></div>
        <div class="screen-line short"></div>
        <div class="screen-pill"></div>
      </div>
    </div>
  </div>

  <div class="container hero-copy">
    <p class="brand">{site.name}</p>
    <h1>为思考而设计的科技博客。</h1>
    <p class="lead">工程实践、产品直觉与数字美学，用更干净的方式记录。</p>
    <div class="cta">
      <a class="btn primary" href={withBase("/posts/")}>开始阅读</a>
      <a class="btn ghost" href={withBase("/about/")}>关于作者</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    align-content: end;
    padding: 3rem 0 5rem;
    overflow: clip;
    background: #000;
    color: #f5f5f7;
  }

  .hero-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }

  .glow-a {
    width: min(70vw, 520px);
    height: min(70vw, 520px);
    top: 8%;
    right: 8%;
    background: radial-gradient(circle, rgba(0, 113, 227, 0.55), transparent 68%);
  }

  .glow-b {
    width: min(50vw, 380px);
    height: min(50vw, 380px);
    top: 28%;
    left: 5%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.18), transparent 70%);
  }

  .device {
    position: absolute;
    right: max(4%, calc(50% - 520px));
    bottom: 12%;
    width: min(42vw, 360px);
    aspect-ratio: 0.72;
    border-radius: 36px;
    padding: 10px;
    background: linear-gradient(160deg, #3a3a3c, #1c1c1e 55%, #0b0b0c);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    animation: fade-up 1s var(--ease) both;
  }

  .screen {
    height: 100%;
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 30%),
      linear-gradient(165deg, #1d1d1f, #111113 60%, #0a0a0b);
    padding: 18% 14% 14%;
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .screen-line {
    height: 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.16);
  }

  .screen-line.short {
    width: 62%;
    background: rgba(255, 255, 255, 0.1);
  }

  .screen-pill {
    margin-top: 8%;
    width: 44%;
    height: 28px;
    border-radius: 980px;
    background: #0071e3;
    box-shadow: 0 8px 24px rgba(0, 113, 227, 0.35);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 560px;
    animation: fade-up 0.9s var(--ease) both;
  }

  .brand {
    margin: 0 0 0.85rem;
    font-size: clamp(48px, 10vw, 80px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(28px, 4.5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .lead {
    margin: 0 0 1.75rem;
    font-size: 21px;
    line-height: 1.381;
    font-weight: 400;
    color: #a1a1a6;
    max-width: 28ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius-pill);
    font-size: 17px;
    font-weight: 400;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .btn:hover {
    transform: scale(1.01);
  }

  .btn.primary {
    color: #fff;
    background: var(--accent);
  }

  .btn.primary:hover {
    background: var(--accent-hover);
  }

  .btn.ghost {
    color: #2997ff;
    background: transparent;
  }

  .btn.ghost:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .hero {
      align-content: center;
      text-align: center;
      padding: 4rem 0 4.5rem;
    }

    .hero-copy {
      margin-inline: auto;
    }

    .lead {
      margin-inline: auto;
    }

    .cta {
      justify-content: center;
    }

    .device {
      opacity: 0.35;
      right: -8%;
      bottom: 8%;
      width: 58vw;
    }
  }
</style>
