---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<div class="section-head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="desc">{description}</p>}
</div>

<style>
  .section-head {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .desc {
    margin: 0 auto;
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 34ch;
  }
</style>
