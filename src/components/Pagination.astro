---
import { pageHref } from "../lib/posts";

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
const show = totalPages > 1;
---

{
  show && (
    <nav class="pagination" aria-label="文章分页">
      {page > 1 ? (
        <a href={pageHref(page - 1)}>← 上一页</a>
      ) : (
        <span class="disabled">← 上一页</span>
      )}
      <span class="status">
        {page} / {totalPages}
      </span>
      {page < totalPages ? (
        <a href={pageHref(page + 1)}>下一页 →</a>
      ) : (
        <span class="disabled">下一页 →</span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  a:hover {
    opacity: 0.65;
  }

  .disabled,
  .status {
    color: var(--ink-muted);
  }
</style>
