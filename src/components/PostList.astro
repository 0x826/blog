---
import type { Post } from "../lib/posts";
import { formatDate } from "../lib/posts";
import { postHref } from "../lib/paths";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <h2>
            <a href={postHref(post.id)}>{post.data.title}</a>
          </h2>
          <p class="meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate, "long")}
            </time>
            <span class="sep">·</span>
            <span>{post.data.category}</span>
          </p>
          <p class="desc">{post.data.description}</p>
        </article>
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 2.25rem;
  }

  h2 {
    margin: 0 0 0.35rem;
    font-family: var(--font-sans);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  h2 a {
    color: var(--accent);
  }

  .meta {
    margin: 0 0 0.35rem;
    font-size: 0.92rem;
    color: var(--ink-faint);
  }

  .sep {
    margin: 0 0.25rem;
  }

  .desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }
</style>
